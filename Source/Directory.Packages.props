<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Core">
    <PackageVersion Include="Krafs.Rimworld.Ref" Version="1.6.4850" />
    <PackageVersion Include="Lib.Harmony" Version="2.4.2" />
    <PackageVersion Include="RimWorld.MultiplayerAPI" Version="0.6.0" />
    <PackageVersion Include="Zetrith.Prepatcher" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup Label="IO">
    <PackageVersion Include="LiteNetLib" Version="1.3.1" />
    <PackageVersion Include="RestSharp" Version="106.15.0" />
    <PackageVersion Include="System.IO.Compression" Version="4.3.0" />
    <PackageVersion Include="Tomlyn" Version="0.16.2" />
  </ItemGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="Krafs.Publicizer" Version="2.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="MSBuildGitHash" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.collector" Version="3.1.2" />
    <PackageVersion Include="FluentAssertions" Version="8.8.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.3.2" />
    <PackageVersion Include="NUnit" Version="4.4.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.10.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.2.0" />
    <PackageVersion Include="Verify.NUnit" Version="21.3.0" />
  </ItemGroup>
</Project>
